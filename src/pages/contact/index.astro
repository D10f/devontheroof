---
import Layout from '../../layouts/Layout.astro';
import Obfuscator from '../../components/Obfuscator.astro';
import { obfuscate } from '../../scripts/utils';

const emailChallenge = obfuscate(import.meta.env.EMAIL.trim());
const pgpKeyChallenge = obfuscate(import.meta.env.PGP_KEY.trim());
---

<Layout title="Contact">
	<header>
		<h1>Let's talk</h1>
		<p class="preamble">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Consequatur perspiciatis nam minus, id consectetur voluptate a vel quaerat laborum facilis?</p>
	</header>

	<section>
		<h2>Email Address</h2>
		<article>
			<Obfuscator challenge={emailChallenge} />
		</article>
	</section>

	<section>
		<h2>Public Key</h2>
		<article>
			<Obfuscator challenge={pgpKeyChallenge} />
		</article>
	</section>
</Layout>

<style>
	p.preamble {
		margin-bottom: 1em;
		color: var(--subtitles);

		a {
			border-bottom: 2px solid var(--accent-color);

			&:visited {
				color: var(--ctp-latte-mauve);
			}

			&:focus,
			&:hover {
				color: var(--accent-color);
			}
		}
	}

	h2 {
		margin-block: 1em 0.25em;
	}

	p {
		margin-block: 0.5em;
	}

	article {
		background-color: var(--background-color-2);
		border-radius: var(--border-radius);
		padding: 1em;
		margin-block: 1em;
		overflow: scroll;
	}

	summary ~ * {
		margin-left: 1em;
	}

	h3 {
		margin-bottom: 1em;
	}
</style>
