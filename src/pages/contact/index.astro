---
import Layout from '../../layouts/Layout.astro';
import Obfuscator from '../../components/Obfuscator.astro';
---

<Layout>
	<header>
		<h1>Let's talk</h1>
		<p class="preamble">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Consequatur perspiciatis nam minus, id consectetur voluptate a vel quaerat laborum facilis?</p>
	</header>

	<section>
		<h2>Email Address</h2>
		<article>
			<Obfuscator
				ciphertext='c3ed4b7d47267578c55270546c276df148c50f5b210696db8d82b9875c03ccff8b0308'
				iv='6e2d526ab3783dac3f9dafec'
				salt='29a20f9e55f8bfb05c5be3732386'
				iterations={1000}
				nonce='19ddec9b507dc3af4723e52bc1cc60c5'
			/>
		</article>
	</section>

	<section>
		<h2>Public Key</h2>
		<article>
			<Obfuscator
				ciphertext=''
				iv='a9550a97871a06b82dc5bc11'
				salt='ecac7a62a74d8e36dfda3b5348aa'
				iterations={1000}
				nonce='2b459bba3e7d99dffb586d40bb80fd0c'
			/>
		</article>
	</section>
</Layout>

<style>
	p.preamble {
		margin-bottom: 1em;
		color: var(--subtitles);

		a {
			border-bottom: 2px solid var(--accent-color);

			&:visited {
				color: var(--ctp-latte-mauve);
			}

			&:focus,
			&:hover {
				color: var(--accent-color);
			}
		}
	}

	h2 {
		margin-block: 1em 0.25em;
	}

	p {
		margin-block: 0.5em;
	}

	article {
		background-color: var(--background-color-2);
		border-radius: var(--border-radius);
		padding: 1em;
		margin-block: 1em;
		overflow: scroll;
	}

	summary ~ * {
		margin-left: 1em;
	}

	h3 {
		margin-bottom: 1em;
	}
</style>
