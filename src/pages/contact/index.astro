---
import Layout from '../../layouts/Layout.astro';
import Obfuscator from '../../components/Obfuscator.astro';
---

<Layout>
	<header>
		<h1>Let's talk</h1>
		<p class="preamble">Lorem ipsum dolor, sit amet consectetur adipisicing elit. Consequatur perspiciatis nam minus, id consectetur voluptate a vel quaerat laborum facilis?</p>
	</header>

	<section>
		<h2>Email Address</h2>
		<article>
			<Obfuscator
				ciphertext='dddc6c18c51b53781f481ecd02b00c0249ae71cfb15be5e9d2f6a7aed3b6978dfb5708'
				iv='9a210da985a6634d77be5032'
				salt='1bb6c1f47b9cd9b6cfaaa17a47d70fce'
				iterations={220062}
				nonce='c717b949cb3309f3661c49ea9fd4ec2f'
			/>
		</article>
	</section>

	<section>
		<h2>Public Key</h2>
		<article>
			<Obfuscator
				ciphertext=''
				iv='3b854bc2c5d7aea626bdaeff'
				salt='29a61c8fd0f9458f0e776698a591ae83'
				iterations={220045}
				nonce='7de11592a4fbd5279d73d2372bcfeff9'
			/>
		</article>
	</section>
</Layout>

<style>
	p.preamble {
		margin-bottom: 1em;
		color: var(--subtitles);

		a {
			border-bottom: 2px solid var(--accent-color);

			&:visited {
				color: var(--ctp-latte-mauve);
			}

			&:focus,
			&:hover {
				color: var(--accent-color);
			}
		}
	}

	h2 {
		margin-block: 1em 0.25em;
	}

	p {
		margin-block: 0.5em;
	}

	article {
		background-color: var(--background-color-2);
		border-radius: var(--border-radius);
		padding: 1em;
		margin-block: 1em;
		overflow: scroll;
	}

	summary ~ * {
		margin-left: 1em;
	}

	h3 {
		margin-bottom: 1em;
	}
</style>
